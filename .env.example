# URL pública onde o app está hospedado (sem barra no final). A Twilio chama esta URL.
PUBLIC_BASE_URL=https://seu-discador.vercel.app

# Acesso ao app: senha compartilhada pelos SDRs e um segredo aleatório para assinar a sessão
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-um-texto-aleatorio-longo

# Como as ligações saem: "celular" (padrão, sem custo: o botão Ligar abre o discador do aparelho)
# ou "twilio" (liga pelo navegador com gravação automática no Drive; precisa das variáveis da Twilio abaixo)
CALL_MODE=celular

# Twilio (opcional, só para CALL_MODE=twilio) (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Número que aparece para o lead: o número oficial da Stronix, verificado na Twilio (Verified Caller ID), em formato +55...
TWILIO_CALLER_ID=+5511999999999

# Google: planilha onde ficam os resultados (as abas Histórico e Gravações são criadas sozinhas)
GOOGLE_SHEET_ID=id-da-planilha-que-aparece-na-url

# Acesso à planilha por uma conta de serviço: compartilhe a planilha com este e-mail como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=discador@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Só para CALL_MODE=twilio (gravações enviadas ao seu Drive): use OAuth no lugar da conta de serviço.
# Rode `npm run google-auth` para gerar o refresh token.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# GOOGLE_REFRESH_TOKEN=xxxxxxxx
# GOOGLE_DRIVE_FOLDER_ID=id-da-pasta-das-gravacoes

# Opcional
RECORDING_NOTICE=Esta ligação está sendo gravada.
MAX_ATTEMPTS=3
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá {nome}, tudo bem? Aqui é {sdr} da Stronix.
